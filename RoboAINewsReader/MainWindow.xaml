<Window x:Class="RoboAINewsReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoboAINewsReader"
        mc:Ignorable="d"
        Title="RoboAINewsReader" Height="360" Width="720" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1E293B" Padding="24">
            <StackPanel>
                <TextBlock Text="RoboAINewsReader" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Выберите сценарий прогноза" Foreground="#CBD5E1" FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OpenNewsForecast_Click" Margin="0,0,12,0" Padding="18" Background="White">
                <StackPanel>
                    <TextBlock Text="Прогноз по новостям" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Анализ RSS-новостей через ChatGPT, DeepSeek или последовательный прогон обоими движками."
                               Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#475569"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Click="OpenCandleForecaster_Click" Margin="12,0,0,0" Padding="18" Background="White">
                <StackPanel>
                    <TextBlock Text="Прогноз по свечам" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Выбор акции, загрузка исторических свечей и построение AI-прогноза по OHLCV-данным."
                               Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#475569"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
