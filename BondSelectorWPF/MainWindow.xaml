<!-- FILE: MainWindow.xaml -->
<Window x:Class="BondSelectorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bond Selector (T-Invest) - Portfolio Weights"
        Height="900" Width="1700">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Token -->
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="T-Invest Token:" FontWeight="SemiBold"/>
            <DockPanel LastChildFill="True">
                <TextBox x:Name="TokenBox"
                         Height="26"
                         Margin="0,4,8,0"
                         DockPanel.Dock="Left"
                         MinWidth="1100"
                         VerticalContentAlignment="Center"/>
                <Button Content="Paste"
                        Width="90"
                        Height="26"
                        Margin="0,4,0,0"
                        Click="PasteToken_Click"/>
            </DockPanel>
        </StackPanel>

        <!-- Config -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Width="760">
                <TextBlock Text="issuer_ratings.json path:" FontWeight="SemiBold"/>
                <DockPanel LastChildFill="True">
                    <TextBox x:Name="RatingsPathBox"
                             Height="26"
                             Margin="0,4,8,0"
                             VerticalContentAlignment="Center"
                             Text="issuer_ratings.json"/>
                    <Button Content="Browse..."
                            Width="90"
                            Height="26"
                            Margin="0,4,0,0"
                            Click="BrowseRatings_Click"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Margin="16,0,0,0" Width="220">
                <TextBlock Text="Min corp rating:" FontWeight="SemiBold"/>
                <ComboBox x:Name="MinRatingCombo" Height="26" Margin="0,4,0,0">
                    <ComboBoxItem Content="AAA" />
                    <ComboBoxItem Content="AA+" IsSelected="True"/>
                    <ComboBoxItem Content="AA" />
                    <ComboBoxItem Content="AA-" />
                    <ComboBoxItem Content="A+" />
                    <ComboBoxItem Content="A" />
                    <ComboBoxItem Content="A-" />
                    <ComboBoxItem Content="BBB+" />
                    <ComboBoxItem Content="BBB" />
                    <ComboBoxItem Content="BBB-" />
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="16,0,0,0" Width="220">
                <TextBlock Text="Max spread proxy (%):" FontWeight="SemiBold"/>
                <TextBox x:Name="MaxSpreadBox"
                         Height="26"
                         Margin="0,4,0,0"
                         Text="0.7"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Margin="16,0,0,0" Width="260">
                <TextBlock Text="Min avg daily turnover (RUB):" FontWeight="SemiBold"/>
                <TextBox x:Name="MinTurnoverBox"
                         Height="26"
                         Margin="0,4,0,0"
                         Text="5000000"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Margin="16,0,0,0" Width="220">
                <TextBlock Text="Max nominal (RUB):" FontWeight="SemiBold"/>
                <TextBox x:Name="MaxNominalBox"
                         Height="26"
                         Margin="0,4,0,0"
                         Text="1000000"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center">
            <Button x:Name="RunButton"
                    Content="Build Portfolio"
                    Width="170"
                    Height="32"
                    Click="Run_Click"/>
            <Button Content="Example ratings JSON"
                    Width="170"
                    Height="32"
                    Margin="10,0,0,0"
                    Click="ShowExample_Click"/>
            <TextBlock x:Name="StatusText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Data -->
        <DataGrid x:Name="BondsGrid"
                  Grid.Row="3"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"

                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="115"/>

                <DataGridTextColumn Header="Weight (%)" Binding="{Binding WeightPct}" Width="90"/>
                <DataGridTextColumn Header="BucketWeight (%)" Binding="{Binding BucketWeightPct}" Width="120"/>

                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="95"/>

                <DataGridTextColumn Header="Fwd1Y (%)" Binding="{Binding Forward1YPct}" Width="80"/>
                <DataGridTextColumn Header="Key (%)" Binding="{Binding KeyRatePct}" Width="75"/>
                <DataGridTextColumn Header="FwdExcess (%)" Binding="{Binding ForwardExcessPct}" Width="95"/>

                <DataGridTextColumn Header="YTM (%)" Binding="{Binding YtmPct}" Width="80"/>

                <DataGridTextColumn Header="SpreadProxy (%)" Binding="{Binding SpreadPct}" Width="110"/>
                <DataGridTextColumn Header="AvgTurnover (mln RUB)" Binding="{Binding AvgTurnoverMln}" Width="140"/>

                <DataGridTextColumn Header="T (years)" Binding="{Binding YearsToMaturity}" Width="80"/>
                <DataGridTextColumn Header="Effective Maturity (UTC)" Binding="{Binding EffectiveMaturityDateUtc}" Width="165"/>

                <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}" Width="90"/>
                <DataGridTextColumn Header="ISIN" Binding="{Binding Isin}" Width="130"/>
                <DataGridTextColumn Header="IssuerKey" Binding="{Binding IssuerKey}" Width="220"/>

                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="280"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,0"
                   Foreground="Gray"
                   Text="Liquidity and spread are computed from the last 5 traded daily candles (out of last 30 days). If less than 5 traded days exist, the bond is excluded. Portfolio weights are computed only for bonds with Score > 0; the remainder is Money Market."/>
    </Grid>
</Window>
