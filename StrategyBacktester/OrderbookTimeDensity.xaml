<!--
    OrderbookTimeDensity - визуализация временной плотности цены (time x price)
    на часовых свечах.

    СТРАТЕГИЯ (Time-Density / Horizontal Support-Resistance):
    Для каждой часовой свечи равномерный вес распределяется по всему диапазону Low -> High.
    Между свечами накопленная плотность умножается на коэффициент Decay%.
    Значения плотности обрезаны сверху (ManualRange = 5).

    Назначение: выявление ценовых уровней, на которых рынок проводит больше всего времени,
    то есть зон баланса для внутридневных стратегий.
-->
<Window x:Class="StrategyBacktester.OrderbookTimeDensity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StrategyBacktester"
        xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Orderbook time density check Strategy" Height="450" Width="800" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" Padding="8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Ticker -->
                <TextBlock Text="Ticker:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbTicker"
                          Width="220"
                          Height="24"
                          VerticalAlignment="Center"
                          Margin="4,0,8,0"
                          DisplayMemberPath="DisplayName"/>

                <Rectangle Width="1" Fill="#D0D0D0" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Date range -->
                <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker x:Name="dtFrom" Width="105" Height="24" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker x:Name="dtTo" Width="105" Height="24" VerticalAlignment="Center" Margin="4,0,8,0"/>

                <Rectangle Width="1" Fill="#D0D0D0" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Decay -->
                <TextBlock Text="Decay %:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <xctk:DoubleUpDown x:Name="numDecay" Width="75" Height="24" VerticalAlignment="Center" Margin="4,0,8,0" Value="1" Increment="0.05" Minimum="0" Maximum="100" FormatString="F2"/>

                <!-- Apply -->
                <Button x:Name="btnApply" Content="Apply" Width="70" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" Click="btnApply_Click" IsDefault="True"/>
            </StackPanel>
        </Border>

        <wpf:WpfPlot x:Name="plot" Grid.Row="1"/>
    </Grid>
</Window>
