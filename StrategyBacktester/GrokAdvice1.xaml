<Window x:Class="StrategyBacktester.GrokAdvice1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StrategyBacktester" 
        xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Grok MA Crossover Backtest" Height="450" Width="800" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Акция" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ShareComboBox" Height="28" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Дата с" FontWeight="SemiBold"/>
                    <DatePicker x:Name="FromDatePicker" Height="28" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Дата по" FontWeight="SemiBold"/>
                    <DatePicker x:Name="ToDatePicker" Height="28" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Opt мес." FontWeight="SemiBold"/>
                    <TextBox x:Name="IntervalLenTextBox" Height="28" Margin="0,4,0,0" Text="12"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Delay мес." FontWeight="SemiBold"/>
                    <TextBox x:Name="IntervalDelayTextBox" Height="28" Margin="0,4,0,0" Text="12"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="Check мес." FontWeight="SemiBold"/>
                    <TextBox x:Name="IntervalCheckTextBox" Height="28" Margin="0,4,0,0" Text="12"/>
                </StackPanel>

                <Button x:Name="ApplyButton" Grid.Column="6" Content="Применить" Height="32" Width="105" Margin="0,18,10,0" Click="ApplyButton_Click"/>

                <TextBlock x:Name="StatusText" Grid.Column="7" Margin="0,20,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <wpf:WpfPlot x:Name="plot" Grid.Row="1"/>
        <ScrollViewer Grid.Row="2" x:Name="scroller">
            <TextBox IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="1" TextWrapping="Wrap" AcceptsReturn="true" AcceptsTab="true" VerticalScrollBarVisibility="Auto" Text="{Binding ConsoleText}" TextChanged="TextBox_TextChanged"/>
        </ScrollViewer>
    </Grid>
</Window>

