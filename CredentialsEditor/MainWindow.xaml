<Window x:Class="CredentialsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CredentialsEditor"
        mc:Ignorable="d"
        Title="CredentialsEditor" Height="620" Width="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Фильтр UserName" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="filterTextBox" Width="240" Text="%username%" VerticalContentAlignment="Center"/>
            <Button Content="Обновить" Click="RefreshButton_Click" Margin="10,0,0,0" Padding="12,4"/>
            <Button Content="Добавить ключ" Click="AddButton_Click" Margin="10,0,0,0" Padding="12,4"/>
            <TextBlock x:Name="statusTextBlock" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="credentialsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="CredentialsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TargetName" Binding="{Binding TargetName}" Width="4*"/>
                    <DataGridTextColumn Header="UserName" Binding="{Binding UserName}" Width="2*"/>
                    <DataGridTextColumn Header="LastWritten" Binding="{Binding LastWritten, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="keyEditorPanel"
                    Grid.Column="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="12"
                    Margin="12,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Редактирование ключа" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="TargetName" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox x:Name="targetNameTextBox" Grid.Column="1" Margin="0,0,0,8"/>

                        <TextBlock Text="UserName" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox x:Name="userNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                    </Grid>

                    <TextBox x:Name="secretTextBox"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="deleteButton" Content="Удалить" Click="DeleteButton_Click" Padding="16,5" Margin="0,0,10,0" IsEnabled="False"/>
                        <Button Content="Сохранить" Click="SaveButton_Click" Padding="16,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Фильтр поддерживает SQL-like шаблон: % - любое число символов, _ - один символ. Поиск выполняется по UserName без учета регистра."
                   Foreground="#475569"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
