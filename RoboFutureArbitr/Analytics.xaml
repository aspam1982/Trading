<Window x:Class="RoboFutureArbitr.Analytics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoboFutureArbitr"
        xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"

        mc:Ignorable="d"
        Title="Анализ данных" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.DataContext>
        <local:AnalyticsViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5">
            <Label Content="Период с"/>
            <xceed:DateTimePicker Value="{Binding DateFrom, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            <Label Content=" по "/>
            <xceed:DateTimePicker Value="{Binding DateTo, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            <CheckBox IsChecked="{Binding IncludingCommission}">С учетом коммиссии</CheckBox>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TreeView x:Name="tv" Width="300" ItemsSource="{Binding InstrumentsTreeView}" SelectedItemChanged="TreeView_SelectedItemChanged" />
            <Grid Grid.Column="1">
                <ListView ItemsSource="{Binding SelectedOperations}"/>
            </Grid>
        </Grid>
        <TextBlock Text="{Binding TotalInfo}" Grid.Row="2" Margin="5"/>
    </Grid>
</Window>
