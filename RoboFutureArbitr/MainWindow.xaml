<Window x:Class="RoboFutureArbitr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RoboFutureArbitr" Height="420" Width="720" WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1E293B" Padding="24">
            <StackPanel>
                <TextBlock Text="RoboFutureArbitr" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Выберите режим запуска приложения" Foreground="#CBD5E1" FontSize="14" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OpenDataCollector_Click" Margin="0,0,12,0" Padding="18" Background="White">
                <StackPanel>
                    <TextBlock Text="Сбор данных" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Подключение к T-Invest, подписка на стаканы, сделки, свечи и запись истории для дальнейшего анализа."
                               Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#475569"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Click="OpenDataPresenter_Click" Margin="12,0,12,0" Padding="18" Background="White">
                <StackPanel>
                    <TextBlock Text="Анализ данных" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Загрузка накопленной истории, фильтрация сделок и визуальная проверка отклонений между акцией и фьючерсом."
                               Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#475569"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Click="OpenRobotTrading_Click" Margin="12,0,0,0" Padding="18" Background="White">
                <StackPanel>
                    <TextBlock Text="Торговый робот" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Запуск торгового режима, мониторинг статистики фьючерсов, управление стартом и остановкой робота."
                               Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#475569"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
