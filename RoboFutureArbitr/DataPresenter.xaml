<Window x:Class="RoboFutureArbitr.DataPresenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoboFutureArbitr"
        xmlns:wpfTool="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        d:DataContext="{d:DesignInstance Type=local:DataPresenter, IsDesignTimeCreatable=False}"
        x:Name="page"
        mc:Ignorable="d"
        Title="DataPresenter" Height="1024" Width="1280" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Margin="5">
            <StackPanel Orientation="Horizontal">
                <Button Content="Загрузить файл" Click="Button_Click" Margin="5" Padding="5"/>
                <TextBlock Text="Min deviation%" VerticalAlignment="Center" Margin="5"/>
                <wpfTool:DoubleUpDown Value="{Binding MinDeviation}" Minimum="0.1" Increment="0.05" Width="200" FormatString="#.##" VerticalContentAlignment="Center" Margin="5"/>
                <TextBlock Text="Min commision%" VerticalAlignment="Center" Margin="5"/>
                <wpfTool:DoubleUpDown Value="{Binding MinCommision}" Minimum="0.0" Increment="0.05" Width="200" FormatString="#.##" VerticalContentAlignment="Center" Margin="5"/>
                <TextBlock Text="Max deal money" VerticalAlignment="Center" Margin="5"/>
                <wpfTool:IntegerUpDown Value="{Binding MaxDealMoney}" Minimum="1" Increment="1" Width="200" FormatString="#.##" VerticalContentAlignment="Center" Margin="5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Time from" VerticalAlignment="Center" Margin="5"/>
                <wpfTool:DateTimePicker Value="{Binding TimeFrom}" Width="200" FormatString="#.##" VerticalContentAlignment="Center" Margin="5"/>
                <TextBlock Text="Time to" VerticalAlignment="Center" Margin="5"/>
                <wpfTool:DateTimePicker Value="{Binding TimeTo}" Width="200" FormatString="#.##" VerticalContentAlignment="Center" Margin="5"/>
                <Button Click="Button_Click_1">Only evening</Button>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox Width="420"  ItemsSource="{Binding FuturesList}" SelectedItem="{Binding SelectedFuture}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Path=DisplayName}" Loaded="TextBlock_Loaded" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>
            <Grid Grid.Column="1" x:Name="PlotContainer" Grid.RowSpan="2"/>
            <TextBlock Grid.Row="2" Text="{Binding SummaryInfo}" Margin="5"/>
        </Grid>
    </Grid>
</Window>
