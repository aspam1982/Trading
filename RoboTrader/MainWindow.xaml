<Window x:Name="window" x:Class="RoboTrader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoboTrader"
        mc:Ignorable="d"
        xmlns:icon="https://github.com/nullsoftware/TrayIcon"
        Title="{Binding TitleText}" Icon="/Resources/robot.ico"
        Height="450" Width="800" WindowState="Maximized" WindowStartupLocation="CenterScreen" Closing="window_Closing">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <icon:TrayIconHandlers.TrayIcons>
        <icon:TrayIcon Title="{Binding TitleText}"
                       IconSource="/Resources/robot.ico"
                       DoubleClickCommand="{Binding ToggleVisibilityCommand}"
                       NotificationServiceMemberPath="NotificationService">
            <icon:TrayIcon.ContextMenu>
                <!--This context menu will be converted to System.Windows.Forms.ContextMenu-->
                <ContextMenu>
                    <MenuItem Header="_Expand" Command="{Binding ExpandCommand}" Visibility="{Binding ExpandCommandVisibility}" icon:TrayIcon.IsDefault="True"/>
                    <MenuItem Header="_Collapse" Command="{Binding CollapseCommand}" Visibility="{Binding CollapseCommandVisibility}"/>
                    <Separator/>
                    <MenuItem Header="_Silent Mode" IsCheckable="True" IsChecked="{Binding IsSilentModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Command="{Binding CloseCommand}"/>
                </ContextMenu>
            </icon:TrayIcon.ContextMenu>
        </icon:TrayIcon>
    </icon:TrayIconHandlers.TrayIcons>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Text="{Binding Robot.Status, Mode=OneWay}" Grid.ColumnSpan="3" TextWrapping="Wrap"/>
        <TextBox IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="1" TextWrapping="Wrap" AcceptsReturn="true" AcceptsTab="true" VerticalScrollBarVisibility="Auto" Text="{Binding ConsoleText}"/>
        <Menu Grid.ColumnSpan="3">
            <MenuItem Header="_File">
                <MenuItem Header="_Collapse" Command="{Binding CollapseCommand}" Visibility="{Binding CollapseCommandVisibility}"/>
                <Separator/>
                <MenuItem Header="_Silent Mode" IsCheckable="True" IsChecked="{Binding IsSilentModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding CloseCommand}"/>
            </MenuItem>
            <MenuItem Header="_Robot">
                <MenuItem Header="Clean console" Command="{Binding CleanConsoleCommand}"/>
                <Separator/>
                <MenuItem Header="Start" Visibility="{Binding StartButtonVisibility}" Command="{Binding StartCommand}"/>
                <MenuItem Header="Stop" Visibility="{Binding StopButtonVisibility}" Command="{Binding StopCommand}"/>
            </MenuItem>
            <MenuItem Header="Edit settings" Command="{Binding EditSettingsCommand}"/>
        </Menu>
        <GridSplitter Grid.Column="1" Grid.Row="2" ShowsPreview="False" Width="3"
        HorizontalAlignment="Center" VerticalAlignment="Stretch" />
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
                <ListBox ItemsSource="{Binding Robot.Positions}"/>
            </ScrollViewer>
            <GridSplitter Grid.Row="1" Height="3" ShowsPreview="False" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Text="{Binding Robot.Margin, Mode=OneWay}" AcceptsReturn="true" AcceptsTab="true" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                <Button Grid.Row="1" Content="История" Margin="5" Command="{Binding ViewHistoryCommand}"/>
            </Grid>
        </Grid>

        
    </Grid>
</Window>
